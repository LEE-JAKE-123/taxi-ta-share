# Server-side map provider selection: naver, kakao, or auto.
# Kakao is the MVP provider; use auto only when an explicit fallback policy is approved.
MAP_PROVIDER=kakao

# Server-only credentials. Never add NEXT_PUBLIC_ to these values.
KAKAO_REST_API_KEY=
NAVER_MAPS_CLIENT_ID=
NAVER_MAPS_CLIENT_SECRET=

# Browser-visible Kakao Maps JavaScript SDK key.
NEXT_PUBLIC_KAKAO_MAP_JS_KEY=

# Neon environment identity. Keep development, Preview, and Production values
# separate. The migration URL must be a direct, migration-only credential.
APP_ENVIRONMENT=development
DATABASE_URL=
DATABASE_MIGRATION_URL=
DATABASE_EXPECTED_NAME=
DATABASE_FINGERPRINT=
DATABASE_EXPECTED_RUNTIME_ROLE=
DATABASE_EXPECTED_MIGRATION_ROLE=

# Required by login and signed place-selection tokens. Generate a random value
# of at least 32 characters for each environment; never reuse or commit it.
SESSION_SECRET=

# Server-only authorization for the Vercel production cron request. Generate a
# unique random value per environment. Never expose it with NEXT_PUBLIC_.
CRON_SECRET=

# Closed-demo only. Production permits it solely on taxi-ta-share.vercel.app.
DEMO_ADMIN_LOGIN_ENABLED=false
